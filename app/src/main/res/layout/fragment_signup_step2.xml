<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_signup_step2.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_toolbar_background">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:text="LifeLine"
                android:textColor="@color/black"
                android:textSize="30sp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="회원가입"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 아이디 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이디"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_white_rounded"
            android:hint="아이디를 입력해주세요."
            android:padding="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 비밀번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_white_rounded"
            android:hint="비밀번호를 입력해주세요."
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <!-- 비밀번호 확인 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호 확인"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_white_rounded"
            android:hint="비밀번호를 다시 입력해주세요."
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <!-- 주민번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주민번호"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_white_rounded"
            android:hint="주민번호를 입력해주세요."
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- 성별 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="성별"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_male"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:backgroundTint="@color/gray"
                android:text="남성"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/btn_female"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/gray"
                android:text="여성"
                android:textColor="@color/black" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_register_2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="다음"
            android:backgroundTint="@color/gray"
            android:textColor="@color/black"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>