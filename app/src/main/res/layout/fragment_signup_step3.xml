<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_signup_step3.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/rounded_toolbar_background">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:text="LifeLine"
                android:textColor="@color/black"
                android:textSize="30sp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="회원가입"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 주소 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="주소"
            android:textSize="14sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:hint="주소를 입력해주세요."
            android:background="@drawable/button_white_rounded"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- 사회복지사 ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="담당 사회복지사 ID"
            android:textSize="14sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:hint="사회복지사 ID를 입력해주세요."
            android:background="@drawable/button_white_rounded"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- 보호자 휴대전화 번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="보호자 휴대전화 번호"
            android:textSize="14sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:hint="보호자 휴대전화 번호를 입력해주세요."
            android:background="@drawable/button_white_rounded"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="phone" />

        <!-- 가입 버튼 -->
        <Button
            android:id="@+id/btn_register_3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="가입하기"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:backgroundTint="@color/gray" />
    </LinearLayout>
</ScrollView>
