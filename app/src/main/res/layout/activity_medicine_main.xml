<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 상단 툴바 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/surface_primary">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:paddingHorizontal="20dp"
                app:navigationIcon="@drawable/baseline_arrow_back_24"
                app:navigationIconTint="@color/text_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="LifeLine"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/pretendard_semibold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_date_container"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvToolbarDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2025.05.27 (화)"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/pretendard_medium"
                            android:layout_marginEnd="8dp" />

                        <ImageView
                            android:id="@+id/btnCalendar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/accent_primary"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.card.MaterialCardView>

        <!-- 헤더 영역 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/accent_primary"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/headerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="column">

                    <TextView
                        android:id="@+id/tvRoutineTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이형석님의 섭취 루틴"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:fontFamily="@font/pretendard_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘의 복약 일정을 확인하세요"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:alpha="0.8"
                        android:fontFamily="@font/pretendard_medium"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_add"
                    app:backgroundTint="@color/white"
                    app:tint="@color/accent_primary"
                    app:fabSize="normal"
                    app:elevation="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 복약 루틴 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMedicineRoutine"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:padding="20dp"
            android:paddingBottom="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>