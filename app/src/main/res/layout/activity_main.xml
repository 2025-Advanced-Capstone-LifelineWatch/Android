<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_primary">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 로고 이미지 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logo_card"
        android:layout_width="320dp"
        android:layout_height="400dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:scaleType="centerInside"
            android:padding="20dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 로그인 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="340dp"
        android:layout_height="64dp"
        android:text="로그인"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/pretendard_bold"
        android:backgroundTint="@color/accent_primary"
        app:cornerRadius="32dp"
        app:elevation="8dp"
        app:icon="@drawable/ic_login"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_card"
        app:layout_constraintBottom_toTopOf="@+id/btn_signup"
        app:layout_constraintVertical_bias="0.3" />

    <!-- 회원가입 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_signup"
        android:layout_width="340dp"
        android:layout_height="56dp"
        android:text="회원가입"
        android:textColor="@color/accent_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/pretendard_bold"
        android:backgroundTint="@color/surface_primary"
        app:cornerRadius="28dp"
        app:elevation="6dp"
        app:strokeColor="@color/accent_primary"
        app:strokeWidth="2dp"
        app:icon="@drawable/ic_person_add"
        app:iconGravity="textStart"
        app:iconTint="@color/accent_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_login"
        app:layout_constraintVertical_bias="0.2" />

    <!-- 장식용 원형 요소들 -->
    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/shape_circle_accent_light"
        android:alpha="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginStart="-60dp" />

    <View
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/shape_circle_accent_light"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="20dp" />

    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/shape_circle_accent_light"
        android:alpha="0.1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-50dp"
        android:layout_marginEnd="-50dp" />

    <View
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/shape_circle_accent_light"
        android:alpha="0.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="120dp"
        android:layout_marginStart="30dp" />
</androidx.constraintlayout.widget.ConstraintLayout>