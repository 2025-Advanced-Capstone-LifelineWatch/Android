<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 상단 툴바 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/surface_primary"
                android:layout_marginBottom="24dp">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="LifeLine"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:letterSpacing="0.02" />
                </com.google.android.material.appbar.MaterialToolbar>
            </com.google.android.material.card.MaterialCardView>

            <!-- 사용자 프로필 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/surface_primary"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_profile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_placeholder"
                        android:layout_marginEnd="16dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="김건우"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/pretendard_bold" />

                        <TextView
                            android:id="@+id/tv_login_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="로그인 중"
                            android:textSize="14sp"
                            android:textColor="@color/accent_primary"
                            android:fontFamily="@font/pretendard_medium"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_online_indicator" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 사회복지사 연락 버튼들 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_call"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="전화"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:fontFamily="@font/pretendard_bold"
                    android:backgroundTint="@color/surface_primary"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/accent_primary"
                    app:strokeWidth="2dp"
                    app:icon="@drawable/ic_phone"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent_primary"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chat"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="채팅"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/pretendard_bold"
                    android:backgroundTint="@color/accent_primary"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 담당 사회복지사 정보 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/surface_primary"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/gradient_accent"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/social_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="담당 사회복지사 정보"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/pretendard_bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_sical_worker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_placeholder"
                            android:layout_marginEnd="16dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/social_worker_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="김철수"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/pretendard_semibold" />

                            <TextView
                                android:id="@+id/social_worker_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="010-1234-5678"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/pretendard_medium"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 복약 관리 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/surface_primary"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/gradient_accent"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/drug_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="복약 관리"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/pretendard_bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_medicine"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="💊 복약안내 알람 설정"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/pretendard_bold"
                        android:backgroundTint="@color/accent_primary"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_medication"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 개인 정보 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/surface_primary"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/gradient_accent"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/info_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="인적 정보 | 건강 정보"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/pretendard_bold" />
                    </LinearLayout>

                    <!-- 내 정보 -->
                    <LinearLayout
                        android:id="@+id/layout_myinfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_placeholder"
                            android:layout_marginEnd="16dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="내 정보"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/pretendard_semibold" />

                            <TextView
                                android:id="@+id/my_birth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1930.05.25"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/pretendard_medium"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 보호자 정보 -->
                    <LinearLayout
                        android:id="@+id/layout_guardian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_placeholder"
                            android:layout_marginEnd="16dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="보호자 정보"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/pretendard_semibold" />

                            <TextView
                                android:id="@+id/protector_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="김철수"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/pretendard_medium"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/protector_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="010-1234-5678"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/pretendard_medium" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 하단 메뉴 버튼들 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/health_check"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="건강 관리"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/pretendard_bold"
                    android:backgroundTint="@color/accent_primary"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_health"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/my_page"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="마이 페이지"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:fontFamily="@font/pretendard_bold"
                    android:backgroundTint="@color/surface_primary"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/accent_primary"
                    app:strokeWidth="2dp"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>