<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:layout_marginTop="19dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/rounded_toolbar_background">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_semibold"
            android:text="LifeLine"
            android:textColor="@color/black"
            android:textSize="30sp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 건강 카드 영역 -->
    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/semi_title"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_selected_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="나의 건강 상태"
            android:textColor="@android:color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <GridLayout
            android:id="@+id/gridDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:columnCount="2"
            android:useDefaultMargins="true"
            android:alignmentMode="alignMargins">

            <!-- 혈압 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_blood_pressure"
                android:layout_width="160dp"
                android:layout_height="150dp"
                android:layout_margin="8dp"
                android:layout_gravity="fill"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="혈압"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="30dp"
                        android:contentDescription="그래프 아이콘"
                        android:src="@drawable/blood_pressure" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 체온 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_temperature"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_margin="8dp"
                android:layout_gravity="fill"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="체온"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="57dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:contentDescription="그래프 아이콘"
                        android:src="@drawable/thermometer" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 호흡 수 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_respiration"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="8dp"
                android:layout_gravity="fill"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="호흡 수"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="71dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:contentDescription="그래프 아이콘"
                        android:src="@drawable/breathing" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 걸음 수 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_steps"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_margin="8dp"
                android:layout_gravity="fill"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="걸음 수"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:contentDescription="그래프 아이콘"
                        android:src="@drawable/shoes" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 칼로리 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_calories"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_margin="8dp"
                android:layout_gravity="fill"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="92dp"
                        android:text="칼로리\n소모량"
                        android:textColor="@android:color/black"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_steps"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_margin="8dp"
                android:layout_gravity="fill"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/plus" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>
    </ScrollView>
</LinearLayout>
